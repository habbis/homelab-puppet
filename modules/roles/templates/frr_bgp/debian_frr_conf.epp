###
# managed by puppet
###
frr defaults traditional
# default to using syslog. /etc/rsyslog.d/45-frr.conf places the log in
# /var/log/frr/frr.log
log syslog informational

hostname <%= $facts['networking']['fqdn'] %>
!
router bgp <%= $roles::frr_bgp::bgp_nr %>
 bgp router-id <%= $facts['networking']['ip'] %>
 no bgp ebgp-requires-policy
 !
 neighbor <%= $facts['get_default_gateway'] %> remote-as 65000
 neighbor <%= $facts['get_default_gateway'] %> description UDM-Pro-Max
 !
<% if $roles::frr_bgp::type_frr_server == main { -%>
 address-family ipv4 unicast eth0
  network <%= $roles::frr_bgp::anycast_ipv4_address %>/32
  neighbor <%= $facts['get_default_gateway'] %> activate
  neighbor <%= $facts['get_default_gateway'] %> soft-reconfiguration inbound
 exit-address-family
!
<% } -%>
<% if $roles::frr_bgp::type_frr_server == secondary { -%>
 address-family ipv4 unicast eth0
  network <%= $roles::frr_bgp::anycast_ipv4_address %>/32
  neighbor <%= $facts['get_default_gateway'] %> activate
  neighbor <%= $facts['get_default_gateway'] %> soft-reconfiguration inbound
  neighbor <%= $facts['get_default_gateway'] %>  route-map PREPEND out
 exit-address-family
!
route-map PREPEND permit 10
  set as-path prepend <%= $roles::frr_bgp::bgp_nr %> <%= $roles::frr_bgp::bgp_nr %> <%= $roles::frr_bgp::bgp_nr %>
<% } -%>
